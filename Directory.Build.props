<Project>
  <!--
    Shared settings for every .NET project in this repo.
    To target a different .NET version (e.g. net9.0 or net10.0), change it here only.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
